# Infra settings for the analytics collector. install.sh copies this to
# /etc/analytics/analytics.env, where both systemd units load it
# (EnvironmentFile=); docker compose reads it as `.env` (env_file:). The
# binary itself reads plain environment variables.
# Commented lines show the built-in defaults.

DATABASE_URL=sqlite:///var/lib/analytics/analytics.db
PROJECTS_FILE=/etc/analytics/projects.json
#LISTEN_ADDR=127.0.0.1:8080
#GEO_URL=cloudflare://

#LOG_LEVEL=info
#LOG_FORMAT=json
#LOG_FILE=

#BUFFER_FLUSH_MAX_EVENTS=1000
#BUFFER_FLUSH_INTERVAL=5s
#BUFFER_CAPACITY=10000

#RETENTION_WEB_RAW_DAYS=7
#RETENTION_WEB_AGGREGATE_DAYS=365
#RETENTION_PRODUCT_RAW_DAYS=30
#RETENTION_PRODUCT_AGGREGATE_DAYS=365

# `analytics dashboards` (the Evidence renderer). DASHBOARDS_DB_PATH defaults
# to the DATABASE_URL path; a machine that only reads a replica points it at
# the restored file instead. DASHBOARDS_INTERVAL is the minimum spacing
# between Evidence rebuilds.
#DASHBOARDS_DB_PATH=
#DASHBOARDS_ADDR=0.0.0.0:3000
#DASHBOARDS_INTERVAL=15m
#DASHBOARDS_PROJECT_DIR=/opt/evidence
#DASHBOARDS_WORK_DIR=/var/lib/dashboards

# R2/S3 credentials, needed only if you replicate with litestream — the
# application itself never touches object storage. See docs/litestream.md.
#LITESTREAM_ACCESS_KEY_ID=CHANGE_ME
#LITESTREAM_SECRET_ACCESS_KEY=CHANGE_ME
#R2_BUCKET=CHANGE_ME
#R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Infra settings for the analytics collector. install.sh copies this to
# /etc/analytics/analytics.env, where both systemd units load it
# (EnvironmentFile=); docker compose reads it as `.env` (env_file:). The
# binary itself reads plain environment variables.
# Commented lines show the built-in defaults.

DATABASE_URL=sqlite:///var/lib/analytics/analytics.db
PROJECTS_FILE=/etc/analytics/projects.json
#LISTEN_ADDR=127.0.0.1:8080
#GEO_URL=cloudflare://

#LOG_LEVEL=info
#LOG_FORMAT=json
#LOG_FILE=

#BUFFER_FLUSH_MAX_EVENTS=1000
#BUFFER_FLUSH_INTERVAL=5s
#BUFFER_CAPACITY=10000

#RETENTION_WEB_RAW_DAYS=7
#RETENTION_WEB_AGGREGATE_DAYS=365
#RETENTION_PRODUCT_RAW_DAYS=30
#RETENTION_PRODUCT_AGGREGATE_DAYS=365
#RETENTION_APP_RAW_DAYS=30
#RETENTION_APP_AGGREGATE_DAYS=365

# `analytics sync` (backoffice replica refresh)
#SYNC_INTERVAL=5m
#SYNC_LITESTREAM_CONFIG=/etc/litestream.yml
#SYNC_REPLICA_PATH=

# R2/S3 credentials for litestream replication (litestream.service and
# `analytics sync` restores).
LITESTREAM_ACCESS_KEY_ID=CHANGE_ME
LITESTREAM_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=CHANGE_ME
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
